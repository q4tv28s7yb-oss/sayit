# sayit 长期配置：复制为 ~/.sayit/config.env 后修改；命令行参数与环境变量会临时覆盖
# 音色：用 sayit -l 查看全部中文神经音色
TTS_VOICE="zh-CN-XiaoxiaoNeural"
# 语速：+8% 略快于默认，播报不拖沓
TTS_RATE="+8%"
# 音调：+0Hz 保持不变，想要更清脆可试 +2Hz
TTS_PITCH="+0Hz"
# 播放增益（afplay -v，0~1 之间；留空或注释掉 = 系统原音量）
# TTS_GAIN="0.9"
# 合成超时秒数，超时直接回退系统语音，避免卡住
TTS_TIMEOUT="12"
# 断网/超时回退用的系统音色与语速（Tingting 是 macOS 自带中文女声，比默认英文音色自然）
TTS_FALLBACK_VOICE="Tingting"   # Linux 下回退用 espeak-ng，此项忽略
TTS_FALLBACK_RATE="180"
# 超过多少字才启用分句流水线（短句整段合成，语气更连贯）
TTS_CHUNK_MIN="80"
